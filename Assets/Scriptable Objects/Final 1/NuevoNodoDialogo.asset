  m_Script: {fileID: 11500000, guid: 6ee722cce5cb5164798838a953cdd67b, type: 3}
  m_Name: NuevoNodoDialogo
  m_EditorClassIdentifier: 
  dialogueLines:
  - characterName: Jugador
    text: Hey!
    characterSprite: {fileID: 1395028209, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: ???
    text: "Voy de salida \xBFnecesitas algo?"
    characterSprite: {fileID: 152283693, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Jugador
    text: "Ah s\xED\u2026 Encontr\xE9 estas copias y quise traerlas, me parece que
      son tuyas\r"
    characterSprite: {fileID: 561683164, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: ???
    text: "\u2026"
    characterSprite: {fileID: 152283693, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: ???
    text: "No pueden ser m\xEDas porque apenas mande a imprimir, \xBFAlguien te mand\xF3
      a dejarme trabajo extra?"
    characterSprite: {fileID: 561683164, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Jugador
    text: "No, no encontr\xE9 las copias y pens\xE9 que eran tuyas"
    characterSprite: {fileID: 152283693, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: ???
    text: "Sabes que, sal de aqu\xED y ll\xE9vate esos papeles que no son m\xEDos
      y aun asi lo fueran nadie te pidi\xF3 el favor, sal de mi cub\xEDculo que necesito
      seguir trabajando\r"
    characterSprite: {fileID: 152283693, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: ???
    text: "Ah y deja de tomar trabajos ajenos, te van a sancionar\r"
    characterSprite: {fileID: 1395028209, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  choices: []
  nextNode: {fileID: 0}
