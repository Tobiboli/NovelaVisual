  dialogueLines:
  - characterName: ...
    text: ...
    characterSprite: {fileID: 0}
  - characterName: Jugador
    text: 'Mi mama me deja unas cintas antes de morir.

'
    characterSprite: {fileID: 1526299315, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Gabriel
    text: " De verdad lo siento\u2026 si quieres podemos hablar de otra cosa."
    characterSprite: {fileID: 1395028209, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Jugador
    text: No, no te preocupes, la verdad necesito compartir esto con alguien
    characterSprite: {fileID: 1395028209, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Gabriel
    text: 'Y cuantas cintas te dejo?

'
    characterSprite: {fileID: 1395028209, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Jugador
    text: "Son 4, de hecho, la ultima no es un video de ella, si no una pel\xEDcula
      que dice que ve\xEDamos juntas cuando era bebe.\r"
    characterSprite: {fileID: 1526299315, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Gabriel
    text: "Que pel\xEDcula es?"
    characterSprite: {fileID: 1395028209, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Jugador
    text: La verdad no se, y ella misma menciona que cuando la vea, la voy a reconocer
      de inmediato
    characterSprite: {fileID: -1351972674, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Gabriel
    text: Bueno, ponla y salimos de dudas.
    characterSprite: {fileID: -1351972674, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
