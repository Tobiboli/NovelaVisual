  dialogueLines:
  - characterName: Jugador
    text: HEY!
    characterSprite: {fileID: 1526299315, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Gabriel
    text: 'Ay perdoname!

      Necesitabas algo? necesito ir por unas impresiones
      de urgencia'
    characterSprite: {fileID: 1395028209, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Jugador
    text: "Hablas de\u2026 \nEstas impresiones?"
    characterSprite: {fileID: 1526299315, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Gabriel
    text: Muchas gracias, pense que alguien mas ya las habia tomado, apenas iba a
      salir a recogerlas ya sabes que las destruyen si no vas por ellas
    characterSprite: {fileID: -1351972674, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Jugador
    text: 'Bueno ya no tienes que ir

      Bueno, solo venia a eso'
    characterSprite: {fileID: -1351972674, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Gabriel
    text: "Oye, perdon\u2026, no se tu nombre pero eres muy agradable, me gustaria
      verte mas seguido por aqui"
    characterSprite: {fileID: -1835251392, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  - characterName: Jugador
    text: Entonces vendre mas seguido...
    characterSprite: {fileID: -1351972674, guid: 3f600a75a755e864a8a4938cdc104269, type: 3}
  choices: []
  nextNode: {fileID: 0}
